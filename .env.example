# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, set this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# On Vercel, set this to your Vercel production URL (e.g. https://your-app.vercel.app).
APP_URL="MY_APP_URL"

# DATABASE_URL (Recommended on Vercel): PostgreSQL connection string (Neon / Supabase / Vercel Postgres).
# When omitted on Vercel, the API gracefully runs with an in-memory seeded store for demos.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional Firebase Admin overrides for Vercel (defaults to firebase-applet-config.json)
# FIREBASE_PROJECT_ID="amped-radius-n01dl"
# FIREBASE_SERVICE_ACCOUNT_JSON=""
